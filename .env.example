# =============================================================================
# Gharbeti — environment
# Copy to .env.local. Never commit .env.local.
# =============================================================================

# --- Public. These reach the browser bundle by design. -----------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only. -------------------------------------------------------------
# Bypasses RLS entirely. Used for exactly four operations (see
# docs/01-architecture.md §4) and every use writes an audit entry.
# A build-time check asserts this string never appears in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the daily viewer hash that dedupes property views without storing
# raw IPs. Rotate monthly; rotation only resets dedupe windows.
VIEW_HASH_SALT=

# --- Google OAuth ------------------------------------------------------------
# Local dev only: read by supabase/config.toml from supabase/.env (gitignored).
# In a hosted project these live in the Supabase dashboard, not here.
# Authorised redirect URI in Google Cloud Console:
#   local:      http://127.0.0.1:54321/auth/v1/callback
#   production: https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Web Push (Phase 9). Generate with: npx web-push generate-vapid-keys ------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@gharbeti.example
