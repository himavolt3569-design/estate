# =============================================================================
# Gharbeti — environment
# Copy to .env.local. Never commit .env.local.
# =============================================================================

# --- Public. These reach the browser bundle by design. -----------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only. -------------------------------------------------------------
# Bypasses RLS entirely. Used for exactly four operations (see
# docs/01-architecture.md §4) and every use writes an audit entry.
# A build-time check asserts this string never appears in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the daily viewer hash that dedupes property views without storing
# raw IPs. Rotate monthly; rotation only resets dedupe windows.
VIEW_HASH_SALT=

# --- Migrations (Prisma) -------------------------------------------------------
# Only the `db:*` scripts read this. The application never connects to Postgres
# directly — it goes through Supabase so that RLS applies — so leaving this
# empty breaks migrations and nothing else.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Take the DIRECT connection (port 5432), not the pooled one on 6543: PgBouncer
# runs in transaction mode, and a migration is one long transaction with DDL in
# it, which transaction mode cannot carry. Symptom if you use the wrong one:
# "prepared statement already exists" or a migration that hangs.
#
# The password is your database password, not the service role key, and it is
# the most powerful credential in the project — it is RLS-exempt and schema-
# changing. Keep it out of .env.example and out of the browser bundle (no
# NEXT_PUBLIC_ prefix, ever).
#
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Google OAuth ------------------------------------------------------------
# Local dev only: read by supabase/config.toml from supabase/.env (gitignored).
# In a hosted project these live in the Supabase dashboard, not here.
# Authorised redirect URI in Google Cloud Console:
#   local:      http://127.0.0.1:54321/auth/v1/callback
#   production: https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Web Push (Phase 9). Generate with: npx web-push generate-vapid-keys ------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@gharbeti.example
