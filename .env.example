# Firebase Web App configuration from Firebase Console > Project settings.
# Use the SAME Firebase project as the Android app. These are public web values.
# Never place a service account private key or password in NEXT_PUBLIC variables.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mero-kotha-1f4f3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional when App Check enforcement and web push are enabled.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Local development only. Use a demo-* project ID and the emulators in
# firebase.json. Production builds always ignore this switch.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# Optional server-only Photon-compatible geocoding service. Defaults to the
# public Photon demo; use your own endpoint for higher search traffic.
GEOCODING_BASE_URL=https://photon.komoot.io/
